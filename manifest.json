{
  "manifest_version": 3,
  "name": "AI Discussion Notes",
  "version": "0.2.0",
  "description": "Save the best things you learn from AI.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Open AI Discussion Notes"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "core/note.js",
        "core/html-to-markdown.js",
        "core/normalize.js",
        "core/pipeline.js",
        "adapters/chrome/kv.js",
        "adapters/chrome/runtime-client.js",
        "adapters/sources/site-profiles.js",
        "adapters/sources/dom-selection-source.js",
        "client/aidn.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
